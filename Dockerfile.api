FROM python:3.14-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends texlive-latex-base texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended texlive-lang-portuguese && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY career ./career
RUN pip install --no-cache-dir .
RUN useradd --create-home appuser && mkdir -p /app/.data && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["uvicorn", "career.api:app", "--host", "0.0.0.0", "--port", "8000"]
